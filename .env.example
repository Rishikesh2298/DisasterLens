# DisasterLens Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets or API keys to the repository.

# Vision Engine Operating Mode: "mock" (oracle ground truth), "cached" (saved responses), or "live" (model API)
VISION_MODE=mock

# Vision Model Provider: "mock", "gemini", etc.
VISION_PROVIDER=mock

# Vision Model Identifier (used when VISION_MODE is "live" or "cached")
VISION_MODEL=gemini-1.5-flash

# Allowed CORS origins for the FastAPI backend (comma-separated list)
# For local development: http://localhost:5173,http://localhost:3000
# For production deployment: configure the production Vercel frontend URL deployed by Rishikesh (e.g. https://<project>.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL for Vite / React client
# In local development: leave as "/api" to use Vite's development proxy (proxies to http://localhost:8000).
# In production on Vercel: set to your Render backend API URL (e.g. "https://disasterlens.onrender.com/api").
VITE_API_BASE_URL=/api

# Base directory for scenario packs and datasets
DATA_DIR=scenarios/demo_city

# Directory for persistent file storage of ingested camera images
UPLOAD_DIR=uploads

# Maximum permitted file size for uploaded observations in bytes (default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# SQLAlchemy database connection string (SQLite for prototype)
DATABASE_URL=sqlite:///./disasterlens.db
