# DisasterLens Frontend Environment Variables
# Copy to .env or .env.local to customize for local or production build.

# API Base URL:
# For local dev with Vite proxy: leave as /api (proxies to http://localhost:8000)
# For production (e.g. Vercel deployment): set to your backend URL, e.g.:
# VITE_API_BASE_URL=https://disasterlens.onrender.com/api
VITE_API_BASE_URL=/api
