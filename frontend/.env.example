# DisasterLens Frontend Environment Variables
# Copy to .env.local to customize for local API mode or production build.

# Backend origin URL (set without trailing /api so both benchmark and routing clients resolve cleanly):
# - For local API mode with both benchmark dashboard and route screen: http://localhost:8000
# - For production on Vercel: set to your Render backend service URL (e.g. https://disasterlens.onrender.com)
# - If left unset in local dev, routing endpoints default to "/api" via the Vite dev proxy.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=false
